# Server-only. Never prefix these names with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
ADMIN_API_TOKEN=replace-with-a-long-random-token

# Vercel Cron authentication — generate with: openssl rand -hex 32
# Must also be set in Vercel project environment variables as CRON_SECRET.
CRON_SECRET=replace-with-a-long-random-secret

# WhatsApp provider — Evolution API (self-hosted) by default.
# See https://doc.evolution-api.com for setup instructions.
MESSAGE_PROVIDER_URL=https://your-evolution-api.example.com
MESSAGE_PROVIDER_API_KEY=replace-with-your-evolution-api-key
MESSAGE_PROVIDER_INSTANCE=replace-with-your-instance-name
MESSAGE_PROVIDER_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# ── WhatsApp Order Bot (optional overrides) ───────────────────────────────────
# WAB_DRY_RUN=true       Processes orders but skips actual WhatsApp sends (test mode)
# WAB_BUSINESS_NAME=     Display name in bot messages (defaults to Caseirinhas da Tatá)
# WAB_SLACK_WEBHOOK_URL= Incoming Webhook URL for new-order + handoff alerts
WAB_DRY_RUN=false
WAB_BUSINESS_NAME=Caseirinhas da Tatá
WAB_SLACK_WEBHOOK_URL=
