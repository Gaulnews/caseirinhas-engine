# Server-only. Never prefix these names with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
ADMIN_API_TOKEN=replace-with-a-long-random-token

# Public: safe to expose to the browser (RLS enforces access, not this key).
# Both names are set to the same value; NEXT_PUBLIC_ is what the browser bundle reads,
# the bare name is what the server-side Supabase Auth client (proxy.ts, Server Components) reads.
SUPABASE_ANON_KEY=replace-with-anon-public-key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-public-key

# Bearer secret for the internal queue dispatcher (called by an external scheduler, not a browser).
QUEUE_DISPATCH_SECRET=replace-with-a-long-random-token

# WhatsApp Business Cloud API (Meta). All three must be set together for real sends to happen —
# if any is missing, the dispatcher falls back to NullMessagingProvider (jobs go to `skipped`,
# nothing is sent). Get these from the Meta Developer Console (developers.facebook.com) after
# setting up a WhatsApp Business Platform app, or from Composio/Rube if that's how the WhatsApp
# Business connection is managed — both ultimately hand you a token for this same Cloud API.
# WHATSAPP_TEMPLATE_NAME must already be an APPROVED template in Meta Business Manager; its body
# variables are filled per-campaign via the structured `template_parameters` field, never free text.
# Do not add real credentials to Git.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Real Meta Cloud API webhook (src/app/api/webhooks/whatsapp/route.ts) — different from
# MESSAGE_PROVIDER_WEBHOOK_SECRET below, which is a simplified bearer-secret endpoint for manual
# testing. WHATSAPP_WEBHOOK_VERIFY_TOKEN is a string you invent and enter in the Meta App Dashboard
# webhook setup (GET verification handshake). META_APP_SECRET is your Meta app's App Secret, used
# to verify the X-Hub-Signature-256 header Meta signs every webhook POST with.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-token
META_APP_SECRET=

MESSAGE_PROVIDER_WEBHOOK_SECRET=replace-with-a-long-random-token
